# ==============================================================================
# College Attendance Monitoring System - Environment Configuration Example
# Copy this file to .env and configure with your Meta & Supabase credentials.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Meta WhatsApp Business Platform Cloud API Credentials
# Obtained from Meta Developer Portal -> WhatsApp -> API Setup
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------------------------
# 2. Approved WhatsApp Message Templates
# Create and approve in Meta WhatsApp Manager -> Message Templates
# ------------------------------------------------------------------------------
# Trigger A: Immediate Absence Alert (Sent to assigned Class Advisor)
WHATSAPP_TEMPLATE_NAME=attendance_absence_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Trigger B: Repeated-Absence Summary (Sent to Dean of Placement & Training)
WHATSAPP_SUMMARY_TEMPLATE_NAME=attendance_repeat_summary
WHATSAPP_SUMMARY_TEMPLATE_LANGUAGE=en_US

# ------------------------------------------------------------------------------
# 3. Meta Webhook Security Configuration
# Used by /webhook endpoint to verify subscription and validate HMAC-SHA256 signatures
# ------------------------------------------------------------------------------
WHATSAPP_WEBHOOK_VERIFY_TOKEN=attendance_webhook_verify_secret_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_hex_string_here

# ------------------------------------------------------------------------------
# 4. College Attendance & Policy Defaults
# ------------------------------------------------------------------------------
DEFAULT_ABSENCE_THRESHOLD=3
DEFAULT_REPORTING_WINDOW_DAYS=7
COLLEGE_TIMEZONE=Asia/Kolkata
DEAN_PLACEMENT_PHONE=+919876543200
DEAN_PLACEMENT_NAME="Dean of Placement and Training"

# ------------------------------------------------------------------------------
# 5. Supabase Backend Infrastructure
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-worker-functions
